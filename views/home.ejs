            <!-- Members Section Style -->
            <style>
                /* Apple-like styling */
                .perspective {
                    perspective: 1000px;
                }
                
                .card-3d {
                    transform-style: preserve-3d;
                    transition: transform 0.5s ease;
                }
                
                .backface-hidden {
