                .card-3d.rotate-y-180 {
                    transform: rotateY(180deg);
                }
                
                /* Text shadow for better readability */
                .text-shadow-sm {
                    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
                }
                
                /* Animation for auto-scrolling */
                @keyframes pulse {
                    0% { transform: scale(1); }
                    50% { transform: scale(1.05); }
                    100% { transform: scale(1); }
                }
                
                /* Fade-in animation for back side */
                .fade-in {
                    animation: fadeIn 0.2s ease-in;
                }
                
                @keyframes fadeIn {
                    0% { opacity: 0; }
                    100% { opacity: 1; }
                }
                
                /* Apple-like indicator dots */
                #members-dots button {
                    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
                }
                
                #members-dots button.active {
                    background-color: #1a202c;
                    transform: scale(1.3);
                }
            </style>
            <!-- Members Section Script -->
            <script>
                // Get all member cards and calculate the total number
                const membersContainer = document.getElementById('members-container');
                const carouselContainer = document.getElementById('carousel-container');
                const memberCards = Array.from(membersContainer.querySelectorAll('.snap-center'));
                const memberDotsContainer = document.getElementById('members-dots');
                let currentMemberIndex = 0;
                let autoScrollInterval;
                let startX, startScrollLeft, isDown = false;
                
                // Create indicator dots with Apple-like styling
                memberCards.forEach((_, index) => {
                    const dot = document.createElement('button');
                    dot.className = h-3 w-3 rounded-full transition-all duration-300 ${index === 0 ? 'bg-gray-800 scale-125 active' : 'bg-gray-400'};
                    dot.onclick = () => goToMemberCard(index);
                    memberDotsContainer.appendChild(dot);
                });
                
                // Function to flip member card with animation when clicked
                function flipMemberCard(card) {
                    // Stop auto-scroll while card is flipped
                    clearInterval(autoScrollInterval);
                    
                    // Stop event propagation to prevent carousel movement
                    event.stopPropagation();
                    
                    if (card.dataset.flipped === "false") {
                        // Apply the rotation transform immediately
                        card.classList.add("rotate-y-180");
                        card.dataset.flipped = "true";
                        
                        // Auto flip back after 3 seconds
                        setTimeout(() => {
                            card.classList.remove("rotate-y-180");
                            card.dataset.flipped = "false";
                            
                            // Resume auto-scroll after card flips back
                            startAutoScroll();
                        }, 3000);
                    } else {
                        // Allow user to flip back manually before the timeout
                        card.classList.remove("rotate-y-180");
                        card.dataset.flipped = "false";
                        
                        // Resume auto-scroll
                        startAutoScroll();
                    }
                }
                
                // Function to go to a specific member card
                function goToMemberCard(index) {
                    // Clear auto-scroll when manually navigating
                    clearInterval(autoScrollInterval);
                    
                    currentMemberIndex = index;
                    memberCards[currentMemberIndex].scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest',
                        inline: 'center'
                    });
                    
                    // Update indicator dots
                    updateMemberDots();
                    
                    // Restart auto-scroll after manual navigation
                    startAutoScroll();
                }
                
                // Update the active dot with Apple-like animation
                function updateMemberDots() {
                    const dots = Array.from(memberDotsContainer.children);
                    dots.forEach((dot, index) => {
                        if (index === currentMemberIndex) {
                            dot.classList.remove('bg-gray-400');
                            dot.classList.add('bg-gray-800', 'scale-125', 'active');
                        } else {
                            dot.classList.remove('bg-gray-800', 'scale-125', 'active');
                            dot.classList.add('bg-gray-400');
                        }
                    });
                }
                
                // Function to automatically scroll the carousel
                function startAutoScroll() {
                    // Clear any existing interval
                    clearInterval(autoScrollInterval);
                    
                    // Set up auto-scroll
                    autoScrollInterval = setInterval(() => {
                        if (currentMemberIndex < memberCards.length - 1) {
                            currentMemberIndex++;
                        } else {
                            currentMemberIndex = 0;
                        }
                        
                        memberCards[currentMemberIndex].scrollIntoView({
                            behavior: 'smooth',
                            block: 'nearest',
                            inline: 'center'
                        });
                        
                        updateMemberDots();
                    }, 4000); // Auto-scroll every 4 seconds
                }
                
                // Handle scroll events to update dots
                membersContainer.addEventListener('scroll', () => {
                    const containerRect = membersContainer.getBoundingClientRect();
                    const center = containerRect.left + containerRect.width / 2;
                    
                    // Find the card closest to the center
                    let closestCard = null;
                    let closestDistance = Infinity;
                    
                    memberCards.forEach((card, index) => {
                        const cardRect = card.getBoundingClientRect();
                        const cardCenter = cardRect.left + cardRect.width / 2;
                        const distance = Math.abs(center - cardCenter);
                        
                        if (distance < closestDistance) {
                            closestDistance = distance;
                            closestCard = card;
                            currentMemberIndex = index;
                        }
                    });
                    
                    updateMemberDots();
                });
                
                // Mouse/Touch events for swipe functionality
                
                // Mouse Down
                membersContainer.addEventListener('mousedown', (e) => {
                    isDown = true;
                    membersContainer.classList.add('active');
                    startX = e.pageX - membersContainer.offsetLeft;
                    startScrollLeft = membersContainer.scrollLeft;
                    clearInterval(autoScrollInterval);
                });
                
                // Mouse Leave
                membersContainer.addEventListener('mouseleave', () => {
                    isDown = false;
                    membersContainer.classList.remove('active');
                    startAutoScroll();
                });
                
                // Mouse Up
                membersContainer.addEventListener('mouseup', () => {
                    isDown = false;
                    membersContainer.classList.remove('active');
                    
                    // Snap to nearest card after swipe
                    memberCards[currentMemberIndex].scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest',
                        inline: 'center'
                    });
                    
                    startAutoScroll();
                });
                
                // Mouse Move for dragging
                membersContainer.addEventListener('mousemove', (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - membersContainer.offsetLeft;
                    const walk = (x - startX) * 2; // Scroll speed multiplier
                    membersContainer.scrollLeft = startScrollLeft - walk;
                });
                
                // Touch events for mobile swipe
                
                // Touch Start
                membersContainer.addEventListener('touchstart', (e) => {
                    isDown = true;
                    membersContainer.classList.add('active');
                    startX = e.touches[0].pageX - membersContainer.offsetLeft;
                    startScrollLeft = membersContainer.scrollLeft;
                    clearInterval(autoScrollInterval);
                });
                
                // Touch End
                membersContainer.addEventListener('touchend', () => {
                    isDown = false;
                    membersContainer.classList.remove('active');
                    
                    // Snap to nearest card after swipe
                    memberCards[currentMemberIndex].scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest',
                        inline: 'center'
                    });
                    
                    startAutoScroll();
                });
                
                // Touch Move
                membersContainer.addEventListener('touchmove', (e) => {
                    if (!isDown) return;
                    const x = e.touches[0].pageX - membersContainer.offsetLeft;
                    const walk = (x - startX) * 2;
                    membersContainer.scrollLeft = startScrollLeft - walk;
                });
                
                // Initial setup on page load
                window.addEventListener('load', () => {
                    if (memberCards.length > 0) {
                        // Initial position
                        memberCards[0].scrollIntoView({
                            block: 'nearest',
                            inline: 'center'
                        });
                        
                        // Add initial animation to the first card
