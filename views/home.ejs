                }
                
                /* Smooth scrolling */
                #members-container {
                    -ms-overflow-style: none;
                    scrollbar-width: none;
                    scroll-behavior: smooth;
                    cursor: grab;
                }
                
                #members-container:active {
                    cursor: grabbing;
                }
                
                #members-container::-webkit-scrollbar {
                    display: none;
                }
                
