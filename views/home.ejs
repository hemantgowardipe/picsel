    <script>
        function typewriterEffect(element, text, delay = 20) {
            element.innerHTML = "";
            let i = 0;
            function type() {
                if (i < text.length) {
                    element.innerHTML += text.charAt(i);
                    i++;
                    setTimeout(type, delay);
                }
            }
            type();
        }
    
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".vision-text").forEach((el, index) => {
                let originalText = el.innerText;
                el.innerText = ""; // Clear text
                setTimeout(() => {
                    typewriterEffect(el, originalText, 30); // Start typewriter effect
                }, index * 1000); // Add delay for each box
            });
        });
    </script>
