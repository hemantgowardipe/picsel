 <style>
    body {
        font-family: 'Inter', sans-serif;
    }

    /* Floating Animation */
    .floating {
        animation: float 3s ease-in-out infinite;
    }
    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    /* Button Hover Effect */
    .btn-glow {
        transition: all 0.3s ease-in-out;
        position: relative;
        overflow: hidden;
    }
    .btn-glow::before {
        content: '';
        position: absolute;
        top: -100%;
        left: -100%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3), transparent);
        transform: rotate(45deg);
        transition: all 0.5s ease-in-out;
    }
    .btn-glow:hover::before {
        top: 0;
        left: 0;
    }

    /* Glowing Timeline */
.timeline-glow {
    position: absolute;
    top: 0;
    left: 50%;
    width: 6px;
    background: linear-gradient(to bottom, #3b82f6, #a855f7);
    box-shadow: 0px 0px 15px rgba(59, 130, 246, 0.8);
    border-radius: 50px;
    height: 100%;
}

/* Animated Dotted Effect */
.timeline-glow::before {
    content: "";
    position: absolute;
    width: 8px;
    height: 8px;
    background: #ffffff;
    border-radius: 50%;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    box-shadow: 0px 0px 10px rgba(255, 255, 255, 0.9);
    animation: moveDown 3s infinite alternate ease-in-out;
}

@keyframes moveDown {
    from {
        top: 0;
    }
    to {
        top: 100%;
    }
}


.vision-box {
        border: 2px solid transparent;
        position: relative;
        overflow: hidden;
    }

    /* Hover effect */
    .vision-box:hover {
        border-color: #4f46e5; /* Change border color */
        box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3); /* Soft glow effect */
        transform: scale(1.05); /* Slight scale effect */
    }

    /* Gradient effect on hover */
    .vision-box::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, rgba(79, 70, 229, 0.1), rgba(79, 70, 229, 0.3), rgba(79, 70, 229, 0.1));
        transition: left 0.5s ease-in-out;
    }

    .vision-box:hover::before {
        left: 100%;
    }

</style>
</head>
