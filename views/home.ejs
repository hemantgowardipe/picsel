            <!-- Teachers Section Script -->
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    // Get all cards and calculate the total number
                    const carouselContainer = document.getElementById('carousel-container');
                    const cards = Array.from(carouselContainer.querySelectorAll('.snap-center'));
                    const dotsContainer = document.getElementById('carousel-dots');
                    let currentIndex = 0;
                    
                    // Touch handling variables
                    let touchStartX = 0;
                    let touchEndX = 0;
                    let isSwiping = false;
                    const swipeThreshold = 10; // Pixels of movement to consider it a swipe
                    
                    // Create indicator dots with enhanced styling
                    cards.forEach((_, index) => {
                        const dot = document.createElement('button');
                        dot.className = `h-3 w-3 rounded-full transition-all duration-300 ${index === 0 ? 'bg-gray-800 scale-125' : 'bg-gray-400'}`;
                        dot.onclick = () => goToCard(index);
                        dotsContainer.appendChild(dot);
                    });
                    
                    // Add click handlers to all card elements
                    cards.forEach(card => {
                        const cardElement = card.querySelector('.preserve-3d');
                        
                        // Add click event listeners to handle card flipping
                        cardElement.addEventListener('click', function(e) {
                            // Only flip if not in the middle of a swipe action
                            if (!isSwiping) {
                                flipCard(this);
                            }
                            e.stopPropagation(); // Prevent event bubbling
                        });
                        
                        // Prevent click events from bubbling when swiping
                        cardElement.addEventListener('touchstart', function(e) {
                            isSwiping = false;
                        });
                    });
                    
                    // Function to flip card with enhanced animations
                    function flipCard(card) {
                        if (card.dataset.flipped === "false") {
                            card.classList.add("rotate-y-180");
                            card.dataset.flipped = "true";
                            
                            // Auto flip back after 3 seconds
                            setTimeout(() => {
                                card.classList.remove("rotate-y-180");
                                card.dataset.flipped = "false";
                            }, 3000);
                        }
                    }
                    
                    // Function to go to a specific card
                    function goToCard(index) {
                        currentIndex = index;
                        cards[currentIndex].scrollIntoView({
                            behavior: 'smooth', 
                            block: 'nearest',
                            inline: 'center'
                        });
                        
                        // Update indicator dots
                        updateDots();
                        
                        // Animate the selected card
                        animateCurrentCard();
                    }
                    
                    // Update the active dot with animation
                    function updateDots() {
                        const dots = Array.from(dotsContainer.children);
                        dots.forEach((dot, index) => {
                            if (index === currentIndex) {
                                dot.classList.remove('bg-gray-400');
                                dot.classList.add('bg-gray-800', 'scale-125');
                            } else {
                                dot.classList.remove('bg-gray-800', 'scale-125');
                                dot.classList.add('bg-gray-400');
                            }
                        });
                    }
                    
                    // Animate the current card
                    function animateCurrentCard() {
                        cards.forEach((card, index) => {
                            if (index === currentIndex) {
                                const cardElement = card.querySelector('.preserve-3d');
                                cardElement.style.animation = 'pulse 0.8s ease-out';
                                setTimeout(() => {
                                    cardElement.style.animation = '';
                                }, 800);
                            }
                        });
                    }
                    
                    // Add touch event listeners for swipe
                    carouselContainer.addEventListener('touchstart', function(e) {
                        touchStartX = e.changedTouches[0].screenX;
                    }, { passive: true });
                    
                    carouselContainer.addEventListener('touchmove', function(e) {
                        // Detect if user is moving finger significantly (swiping)
                        if (Math.abs(e.changedTouches[0].screenX - touchStartX) > swipeThreshold) {
                            isSwiping = true;
                        }
                    }, { passive: true });
                    
                    carouselContainer.addEventListener('touchend', function(e) {
                        touchEndX = e.changedTouches[0].screenX;
                        handleSwipe();
                        
                        // Reset swiping flag after a short delay to allow click events
                        setTimeout(() => {
                            isSwiping = false;
                        }, 50);
                    }, { passive: true });
                    
                    // Handle swipe direction
                    function handleSwipe() {
                        const minSwipeDistance = 50;
                        const swipeDistance = touchEndX - touchStartX;
                        
                        if (swipeDistance > minSwipeDistance && currentIndex > 0) {
                            // Swipe right, go to previous card
                            goToCard(currentIndex - 1);
                        } else if (swipeDistance < -minSwipeDistance && currentIndex < cards.length - 1) {
                            // Swipe left, go to next card
                            goToCard(currentIndex + 1);
                        }
                    }
                    
                    // Handle scroll events to update dots
                    carouselContainer.addEventListener('scroll', function() {
                        const containerRect = carouselContainer.getBoundingClientRect();
                        const center = containerRect.left + containerRect.width / 2;
                        
                        // Find the card closest to the center
                        let closestCard = null;
                        let closestDistance = Infinity;
                        
                        cards.forEach((card, index) => {
                            const cardRect = card.getBoundingClientRect();
                            const cardCenter = cardRect.left + cardRect.width / 2;
                            const distance = Math.abs(center - cardCenter);
                            
                            if (distance < closestDistance) {
                                closestDistance = distance;
                                closestCard = card;
                                currentIndex = index;
                            }
                        });
                        
                        updateDots();
                    });
                    
                    // Add mouse wheel support for horizontal scrolling
                    carouselContainer.addEventListener('wheel', function(e) {
                        if (e.deltaY !== 0) {
                            e.preventDefault();
                            carouselContainer.scrollLeft += e.deltaY;
                        }
                    }, { passive: false });
                    
                    // Initial scroll to first card to ensure proper positioning
                    if (cards.length > 0) {
                        cards[0].scrollIntoView({
                            block: 'nearest',
                            inline: 'center'
                        });
                        
                        // Add initial animation to the first card
                        setTimeout(() => {
                            const firstCard = cards[0].querySelector('.preserve-3d');
                            firstCard.style.animation = 'pulse 1.2s ease-out';
                            setTimeout(() => {
                                firstCard.style.animation = '';
                            }, 1200);
                        }, 500);
                    }
                });
            </script>

