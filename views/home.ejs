<!-- CSS to add to your stylesheet of combined hero and timeline section -->
<style>
    /* Animation for floating elements */
    .floating {
        animation: float 6s ease-in-out infinite;
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.8s forwards, float 6s ease-in-out infinite;
    }

    @keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
    }

    /* Animation for hero content elements */
    .hero-title, .hero-desc, .hero-btn, .hero-images {
        animation: fadeInUp 0.8s forwards;
        animation-delay: 0.2s;
    }
    .hero-desc {
        animation-delay: 0.4s;
    }
    .hero-btn {
        animation-delay: 0.6s;
    }
    .hero-images {
        animation-delay: 0.8s;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Timeline glow effect */
    .timeline-glow {
        height: 0;
        animation: growTimeline 1.5s forwards;
        animation-delay: 1s;
        box-shadow: 0 0 10px rgba(99, 102, 241, 0.6);
    }

    @keyframes growTimeline {
        from { height: 0; }
        to { height: 100%; }
    }

    /* Button glow effect */
    .btn-glow {
        box-shadow: 0 0 15px rgba(37, 99, 235, 0.5);
    }

    /* Floating particles animation */
    @keyframes float {
        0% { transform: translate(0, 0); }
        25% { transform: translate(10px, 10px); }
        50% { transform: translate(0, 20px); }
        75% { transform: translate(-10px, 10px); }
        100% { transform: translate(0, 0); }
    }

    .animate-float {
        animation: float 10s ease-in-out infinite;
    }
    
    /* Ensure responsive timeline for mobile */
    @media (max-width: 768px) {
        .timeline-glow {
            left: 20px;
        }
    }
</style>

<!-- JavaScript for scroll-based animations of combined hero and timeline section -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            // If timeline section is visible, start the timeline animation
            if (entry.isIntersecting) {
                entry.target.classList.add('timeline-visible');
            }
        });
    }, {
        threshold: 0.1
    });

    // Track the timeline section
    const timelineSection = document.querySelector('.timeline-glow');
    if (timelineSection) {
        observer.observe(timelineSection);
    }
});
</script>

