<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="This is the forum website of PICSEL, a student committee of engineering students of branch CSE">
    <title>PICSEL 2025</title>
    
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<%- include('partials/navbar') %>

<div style="display:none;" class="errorbox flexbox flexbox-column">
    <span class="flexbox">
        <button onclick="hideError()">X</button>
    </span>
    <div class="error-message">message</div>
</div>

<h1>Admin Login</h1>
<form onsubmit="handleSubmit(event)">
    <label>
        Username
        <input type="text" name="username" required />
    </label>
    
    <label>
        Password
        <input type="password" name="password" required />
    </label>
    
    <input type="submit" value="Login" />
</form>

<%- include('partials/footer') %>

<script>
async function handleSubmit(event) {
    event.preventDefault(); // Prevent default form submission
    
    const form = event.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    const response = await fetch("/api/login", {
        method: "POST",
        credentials: "include",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(data)
    });

    const result = await response.json();

    if (response.ok) {
        showError("Login successful!");
    } else {
        showError("Login failed: " + result.message);
    }
}

function showError(message) {
    const errorBox = document.querySelector(".errorbox");
    errorBox.style.display = "flex";
    errorBox.querySelector(".error-message").innerText = message;
    document.body.style.overflow = "hidden";
}

function hideError() {
    const errorBox = document.querySelector(".errorbox");
    errorBox.style.display = "none";
    document.body.style.overflow = "auto";
}
</script>
