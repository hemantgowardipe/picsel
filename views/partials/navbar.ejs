<script>
    // Mobile menu toggle
    const mobileMenuButton = document.querySelector('.mobile-menu-button');
    const mobileMenu = document.querySelector('.mobile-menu');

    mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
    });
    
    // Mobile dropdowns
    const mobileDropdownButtons = document.querySelectorAll('.mobile-dropdown-button');
    
    mobileDropdownButtons.forEach(button => {
        button.addEventListener('click', () => {
            const content = button.nextElementSibling;
            content.classList.toggle('hidden');
            const icon = button.querySelector('svg');
            icon.classList.toggle('rotate-180');
        });
    });

    async function authcheck(){
        const response = await fetch('/api/authcheck');
        const data = await response.json();
        console.log(data);
        if(data.status){
            document.getElementById('login').innerHTML = 'Logout';
            document.getElementById('login').href = '/api/logout';
            document.getElementById('login').classList.add('bg-cyan-500', 'hover:bg-cyan-600');
            document.getElementById('login').classList.remove('text-gray-300', 'hover:text-cyan-400');
        }
    }
    authcheck();
</script>