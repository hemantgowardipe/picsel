    <script>
        // Wait for DOM to be fully loaded and ensure THREE is available
        document.addEventListener('DOMContentLoaded', function() {
            // Check if THREE is defined before using it
            if (typeof THREE !== 'undefined') {
                // Enhanced 3D Particle network for hero section
                const canvas = document.getElementById('hero-canvas');
                const renderer = new THREE.WebGLRenderer({
                    canvas: canvas,
                    antialias: true,
                    alpha: true
                });
                
                const scene = new THREE.Scene();
                const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
                camera.position.z = 50;
                
                // Resize handler
                function onWindowResize() {
                    camera.aspect = window.innerWidth / window.innerHeight;
                    camera.updateProjectionMatrix();
                    renderer.setSize(window.innerWidth, canvas.parentElement.clientHeight);
                }
                
                window.addEventListener('resize', onWindowResize);
                onWindowResize();
                
                // Create more particles for enhanced effect
                const particleCount = 300;
                const particles = new THREE.BufferGeometry();
                const positions = new Float32Array(particleCount * 3);
                const colors = new Float32Array(particleCount * 3);
                const sizes = new Float32Array(particleCount);
                
                // Create a color palette
                const colorPalette = [
                    new THREE.Color(0x3b82f6), // blue
                    new THREE.Color(0x06b6d4), // cyan
                    new THREE.Color(0x8b5cf6)  // purple
                ];
                
                for (let i = 0; i < particleCount; i++) {
                    positions[i * 3] = (Math.random() - 0.5) * 100;
                    positions[i * 3 + 1] = (Math.random() - 0.5) * 100;
                    positions[i * 3 + 2] = (Math.random() - 0.5) * 100;
                    
                    // Assign random size with more variation
                    sizes[i] = Math.random() * 2.5;
                    
                    // Assign random color from palette
                    const color = colorPalette[Math.floor(Math.random() * colorPalette.length)];
                    colors[i * 3] = color.r;
                    colors[i * 3 + 1] = color.g;
                    colors[i * 3 + 2] = color.b;
                }
                
                particles.setAttribute('position', new THREE.BufferAttribute(positions, 3));
                particles.setAttribute('color', new THREE.BufferAttribute(colors, 3));
                particles.setAttribute('size', new THREE.BufferAttribute(sizes, 1));
                
                // Create particle material with vertex colors
                const particleMaterial = new THREE.PointsMaterial({
                    size: 1,
                    vertexColors: true,
                    transparent: true,
                    opacity: 0.7,
                    sizeAttenuation: true
                });
                
                // Create particle system
                const particleSystem = new THREE.Points(particles, particleMaterial);
                scene.add(particleSystem);
                
                // Add connections between nearby particles
                const lineMaterial = new THREE.LineBasicMaterial({
                    color: 0x3b82f6,
                    transparent: true,
                    opacity: 0.2
                });
                
                // Create lines for connections
                const lineGeometry = new THREE.BufferGeometry();
                const linePositions = new Float32Array(particleCount * 6); // For each particle, store 2 positions (itself and closest neighbor)
                lineGeometry.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
                const lines = new THREE.LineSegments(lineGeometry, lineMaterial);
                scene.add(lines);
                
                // Animation with movement and connections
                let frame = 0;
                function animate() {
                    requestAnimationFrame(animate);
                    frame += 0.01;
                    
                    // Create subtle wave-like motion
                    for (let i = 0; i < particleCount; i++) {
                        const i3 = i * 3;
                        const x = particles.attributes.position.array[i3];
                        const y = particles.attributes.position.array[i3 + 1];
                        const z = particles.attributes.position.array[i3 + 2];
                        
                        // Add slight wave motion
                        particles.attributes.position.array[i3 + 1] = y + Math.sin(frame + x * 0.1) * 0.1;
                    }
                    particles.attributes.position.needsUpdate = true;
                    
                    // Add slow rotation
                    particleSystem.rotation.x += 0.0003;
                    particleSystem.rotation.y += 0.0005;
                    
                    // Update connections every few frames to save performance
                    if (frame % 2 < 0.01) {
                        updateConnections();
                    }
                    
                    renderer.render(scene, camera);
                }
                
                // Function to update connections between particles
                function updateConnections() {
                    const positions = particles.attributes.position.array;
                    const linePositions = lines.geometry.attributes.position.array;
                    let lineIndex = 0;
                    
                    const connectionDistance = 15; // Maximum distance to draw a connection
                    
                    for (let i = 0; i < particleCount; i++) {
                        const i3 = i * 3;
                        const x1 = positions[i3];
                        const y1 = positions[i3 + 1];
                        const z1 = positions[i3 + 2];
                        
                        // Find closest particle within range
                        for (let j = i + 1; j < particleCount; j++) {
                            const j3 = j * 3;
                            const x2 = positions[j3];
                            const y2 = positions[j3 + 1];
                            const z2 = positions[j3 + 2];
                            
                            // Calculate distance
                            const dx = x1 - x2;
                            const dy = y1 - y2;
                            const dz = z1 - z2;
                            const distance = Math.sqrt(dx * dx + dy * dy + dz * dz);
                            
                            if (distance < connectionDistance && lineIndex < linePositions.length - 6) {
                                // Add line from particle i to j
                                linePositions[lineIndex++] = x1;
                                linePositions[lineIndex++] = y1;
                                linePositions[lineIndex++] = z1;
                                
                                linePositions[lineIndex++] = x2;
                                linePositions[lineIndex++] = y2;
                                linePositions[lineIndex++] = z2;
                            }
                        }
                    }
                    
                    // Fill remaining line positions with far-away points
                    while (lineIndex < linePositions.length) {
                        linePositions[lineIndex++] = 1000;
                    }
                    
                    lines.geometry.attributes.position.needsUpdate = true;
                }
                
                animate();
                
                // GSAP Animations
                gsap.from('.hero-img', {
                    rotateY: 20,
                    opacity: 0,
                    duration: 1.2,
                    ease: "power2.out"
                });
                
                // Enhanced fade-in animations with stagger
                const fadeElements = document.querySelectorAll('.fade-in');
                
                gsap.to(fadeElements, {
                    opacity: 1,
                    y: 0,
                    duration: 1.2,
                    stagger: 0.2,
                    ease: "power3.out"
                });
                
                // Add special animation for hero stats
                gsap.from('.futuristic-border', {
                    scale: 0.8,
                    opacity: 0,
                    duration: 1,
                    stagger: 0.15,
                    delay: 0.5,
                    ease: "back.out(1.7)"
                });
                
                // Interactive elements for hero content
                const heroContent = document.querySelector('.hero-content');
                heroContent.addEventListener('mouseenter', function() {
                    gsap.to(this, {
                        boxShadow: '0 0 30px rgba(59, 130, 246, 0.3)',
                        duration: 0.5
                    });
                });
                
                heroContent.addEventListener('mouseleave', function() {
                    gsap.to(this, {
                        boxShadow: '0 4px 30px rgba(0, 0, 0, 0.1)',
                        duration: 0.5
                    });
                });
            } else {
                console.error("THREE.js library not loaded. Check script loading order.");
                // Fallback to simpler animation if THREE is not available
                const heroSection = document.querySelector('.hero-content');
                heroSection.style.backgroundImage = 'linear-gradient(45deg, #1e293b, #334155)';
                
                // Simple GSAP animations that don't rely on THREE
                gsap.to('.fade-in', {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    stagger: 0.2,
                    ease: "power2.out"
                });
            }
            
        });
        document.addEventListener('DOMContentLoaded', function() {
  // Gallery animation on scroll
  const galleryItems = document.querySelectorAll('.gallery-item');
  
  // Initial check for items in viewport
  checkItemsInViewport();
  
  // Check on scroll
  window.addEventListener('scroll', checkItemsInViewport);
  
  function checkItemsInViewport() {
    galleryItems.forEach(item => {
      const rect = item.getBoundingClientRect();
      const isInViewport = 
        rect.top <= (window.innerHeight || document.documentElement.clientHeight) * 0.9 &&
        rect.bottom >= 0;
        
      if (isInViewport) {
        item.classList.add('visible');
        // Add subtle floating animation to visible items
        setTimeout(() => {
          item.classList.add('subtle-float');
        }, 1000);
      }
    });
  }
  
  // Interactive hover effects
  const gallery = document.getElementById('mesmerizing-gallery');
  
  gallery.addEventListener('mousemove', function(e) {
    const mouseX = e.clientX;
    const mouseY = e.clientY;
    
    galleryItems.forEach(item => {
      if (!item.classList.contains('visible')) return;
      
      const rect = item.getBoundingClientRect();
      const itemX = rect.left + rect.width / 2;
      const itemY = rect.top + rect.height / 2;
      
      // Calculate distance between mouse and item center
      const distanceX = (mouseX - itemX) / 20;
      const distanceY = (mouseY - itemY) / 20;
      
      // Apply subtle transform based on mouse position (limited effect)
      const distance = Math.sqrt(Math.pow(mouseX - itemX, 2) + Math.pow(mouseY - itemY, 2));
      
      // Only apply effect to nearby items
      if (distance < 300) {
        const intensity = (300 - distance) / 300 * 0.5; // Max 0.5 degree rotation
        item.style.transform = `perspective(1000px) rotateX(${-distanceY * intensity}deg) rotateY(${distanceX * intensity}deg)`;
      } else {
        item.style.transform = '';
      }
    });
  });
  
  // Reset transforms when mouse leaves gallery
  gallery.addEventListener('mouseleave', function() {
    galleryItems.forEach(item => {
      item.style.transform = '';
    });
  });
  
  // Add shine effect elements to each gallery item
  galleryItems.forEach(item => {
    const imageContainer = item.querySelector('div');
    if (imageContainer) {
      const shine = document.createElement('div');
      shine.classList.add('image-shine');
      imageContainer.appendChild(shine);
    }
  });
});
    </script>
</body>
