    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap');
        
        :root {
            --black-light: #f9f9f9;
            --black-medium: #333333;
            --black-dark: #111111;
            --accent-color: #3b82f6;
        }
        
        /* body {
            font-family: 'Montserrat', sans-serif;
            scroll-behavior: smooth;
        } */
        
        .hero-img {
            transition: transform 0.5s ease-in-out;
        }
        
        .hero-img:hover {
            transform: scale(1.02);
        }
        
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
        }
        
        .card-hover {
            transition: all 0.3s ease;
        }
        
        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }
        
        #hero-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            opacity: 0.3;
        }
        
        .hero-content {
            position: relative;
            z-index: 1;
            backdrop-filter: blur(5px);
            background-color: rgba(255, 255, 255, 0.8);
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(0, 0, 0, 0.1);
        }
        
        .glow-text {
            text-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        }
        
        .futuristic-border {
            position: relative;
            overflow: hidden;
        }
        
        .futuristic-border::before {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            z-index: -1;
            background: linear-gradient(45deg, #333, transparent, #777, transparent, #333);
            background-size: 400%;
            animation: border-animation 10s linear infinite;
        }
        
        @keyframes border-animation {
            0% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
            100% {
                background-position: 0% 50%;
            }
        }
        
        /* New enhanced hero styles */
        .cyber-grid {
            background-image: 
                linear-gradient(rgba(30, 30, 30, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(30, 30, 30, 0.05) 1px, transparent 1px);
            background-size: 20px 20px;
            animation: grid-move 15s linear infinite;
        }
        
        @keyframes grid-move {
            0% {
                background-position: 0 0;
            }
            100% {
                background-position: 20px 20px;
            }
        }
        
        .pulse-ring {
            animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        
        @keyframes pulse {
            0%, 100% {
                opacity: 0.2;
                transform: scale(1);
            }
            50% {
                opacity: 0.5;
                transform: scale(1.2);
            }
        }
        
        .floating {
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-10px);
            }
        }
        .gallery-item {
  opacity: 0;
  transform: translateY(30px);
  transition: all 1s cubic-bezier(0.5, 0, 0.5, 1);
}

.gallery-item.visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes float-subtle {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-5px) rotate(0.5deg);
  }
  75% {
    transform: translateY(5px) rotate(-0.5deg);
  }
}

.subtle-float {
  animation: float-subtle 8s ease-in-out infinite;
}

/* Stagger delay for items */
.gallery-item:nth-child(2n) {
  transition-delay: 0.1s;
}
.gallery-item:nth-child(3n) {
  transition-delay: 0.2s;
}
.gallery-item:nth-child(4n) {
  transition-delay: 0.3s;
}

/* Image hover effects */
.gallery-item .image-shine {
  position: absolute;
  top: -100%;
  left: -100%;
  right: 0;
  bottom: 0;
  width: 300%;
  height: 300%;
  background: linear-gradient(
    to right, 
    rgba(255,255,255,0) 0%,
    rgba(255,255,255,0.1) 45%,
    rgba(255,255,255,0.1) 55%,
    rgba(255,255,255,0) 100%
  );
  transform: rotate(30deg);
  transition: transform 1s;
}

.gallery-item:hover .image-shine {
  transform: translateX(100%) rotate(30deg);
}

.vision-box {
        border: 2px solid transparent;
        position: relative;
        overflow: hidden;
    }

    /* Hover effect */
    .vision-box:hover {
        border-color: #4f46e5; /* Change border color */
        box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3); /* Soft glow effect */
        transform: scale(1.05); /* Slight scale effect */
    }

    /* Gradient effect on hover */
    .vision-box::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, rgba(79, 70, 229, 0.1), rgba(79, 70, 229, 0.3), rgba(79, 70, 229, 0.1));
        transition: left 0.5s ease-in-out;
    }

    .vision-box:hover::before {
        left: 100%;
    }
    </style>
</head>
