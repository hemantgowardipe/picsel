<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="This is the add member page of PICSEL">
    <title>PICSEL 2025</title>
    
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="errorbox flexbox flexbox-column" style="display:none;">
        <span class="flexbox">
            <button onclick="hideError()">X</button>
        </span>
        <div class="error-message">message</div>
    </div>

    <div class="addmember">
        <h1>Add Member</h1>
        <form onsubmit="handleSubmit(event)" enctype="multipart/form-data" class="flexbox-column">
            <input type="text" name="name" placeholder="Name" required>
            <input type="text" name="post" placeholder="Post" required>
            <input type="file" name="photo" required>
            
            <div class="flexbox-column">
                <label>Is this a teacher?</label>
                <input type="checkbox" name="type">
            </div>

            <button type="submit">Add Member</button>
        </form>
    </div>

    <%- include('partials/footer') %>

    <script>
    async function handleSubmit(event) {
        event.preventDefault(); // Prevent default form submission
        
        const form = event.target;
        const formData = new FormData(form);

        const response = await fetch("/api/addmember", {
            method: "POST",
            credentials: "include",
            body: formData // Automatically handles multipart/form-data
        });

        const result = await response.json();

        if (response.ok) {
            showError("Member added successfully!");
            form.reset(); // Clear form after success
        } else {
            showError("Failed to add member: " + result.message);
        }
    }

    function showError(message) {
        const errorBox = document.querySelector(".errorbox");
        errorBox.style.display = "flex";
        errorBox.querySelector(".error-message").innerText = message;
        document.body.style.overflow = "hidden";
    }

    function hideError() {
        const errorBox = document.querySelector(".errorbox");
        errorBox.style.display = "none";
        document.body.style.overflow = "auto";
    }
    </script>
</body>
</html>
