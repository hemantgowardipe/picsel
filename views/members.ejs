<style>
    /* Glass Morphism Card */
    .glass-card {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .glass-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
    }

    /* Profile Image - Boxy Style with Increased Size */
.profile-img {
    width: 80%; /* Increased width */
    height: 300px; /* Increased height */
    object-fit: cover;
    border-radius: 15px; /* Boxy style with slightly rounded corners */
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease;
    display: block;
    margin: 0 auto; /* Centers the image */
}

/* Hover Effect */
.glass-card:hover .profile-img {
    transform: scale(1.1);
}

/* Responsive Image Sizing */
@media (max-width: 768px) {
    .profile-img {
        width: 120px; /* Slightly smaller for tablets */
        height: 120px;
    }
}

@media (max-width: 480px) {
    .profile-img {
        width: 100px; /* Smaller for mobile */
        height: 100px;
    }
}


    /* Floating Category Navbar */
    .floating-navbar {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        background:transparent;
        padding: 14px 16px;
        border-radius: 10px;
        display: flex;
        gap: 12px;
        z-index: 1000;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        overflow-x: auto;
        white-space: nowrap;
        max-width: 90%;
    }

    /* Category Buttons */
    .category-btn {
        background: linear-gradient(to right, #8e44ad, #3498db);
        color: white;
        border: none;
        padding: 12px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s ease;
        flex-shrink: 0;
    }

    .category-btn:hover, .category-btn.active {
        background: linear-gradient(to right, #e74c3c, #f39c12);
        transform: scale(1.1);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
    }

    /* Mobile-Friendly Scrollable Navbar */
    @media (max-width: 768px) {
        .floating-navbar {
            display: flex;
            justify-content: flex-start;
            padding: 10px;
            overflow-x: auto;
            border-radius: 15px;
            scrollbar-width: none; /* Hide scrollbar for Firefox */
            -ms-overflow-style: none; /* Hide scrollbar for IE & Edge */
        }

        .floating-navbar::-webkit-scrollbar {
            display: none; /* Hide scrollbar for Chrome, Safari */
        }

        .category-btn {
            padding: 10px 14px;
            font-size: 12px;
        }
    }
</style>
    <!-- Floating category script -->
<script>
    function filterMembers(category) {
        let members = document.querySelectorAll('.member-item');
        let buttons = document.querySelectorAll('.category-btn');

        buttons.forEach(btn => btn.classList.remove('active'));
        event.target.classList.add('active');

        if (category === "All") {
            members.forEach(member => member.style.display = "block");
        } else {
            members.forEach(member => {
                member.style.display = member.classList.contains(category) ? "block" : "none";
            });
        }
    }
</script>


