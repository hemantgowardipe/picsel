            <!-- Teachers Section -->
            <!-- Teachers Section -->
<section class="mb-16">
    <h2 class="section-title">Our Teachers</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <% members.forEach((mem, index) => { %>
            <% if (!mem.teacher) return; %>
            <div class="glass-card animate-fadeIn duration-700 delay-<%= index * 100 %>">

                <!-- Profile Image -->
                <img src="<%= mem.photo %>" alt="Teacher" class="profile-img">

                <!-- Name -->
                <h3 class="mt-4 text-2xl font-semibold text-gray-900"><%= mem.name %></h3>

                <!-- Post -->
                <p class="text-gray-600 text-lg mt-2"><%= mem.post %></p>
            </div>
        <% }) %>
    </div>
</section>

