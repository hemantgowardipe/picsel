    <style>
        /* Apply Poppins Font */
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(to right, #f3e8ff, #fff);
            min-height: 100vh;
        }

        /* Section Heading with Hover Effect */
        .section-title {
            font-size: 2.5rem;
            font-weight: 700;
            text-align: center;
            color: #4f46e5;
            margin-bottom: 1.5rem;
            position: relative;
            display: inline-block;
            transition: transform 0.3s ease-in-out, text-shadow 0.3s ease-in-out;
        }

        .section-title::after {
            content: "";
            display: block;
            width: 60px;
            height: 4px;
            background: linear-gradient(45deg, rgba(79, 70, 229, 0.8), rgba(236, 72, 153, 0.8));
            margin: 0.5rem auto 0;
            border-radius: 2px;
        }

        .section-title:hover {
            transform: scale(1.05);
            text-shadow: 0px 0px 8px rgba(79, 70, 229, 0.5);
        }

        /* Card Design with Purple Tint & Glass Effect */
        .glass-card {
            background: rgba(243, 232, 255, 0.8); /* Light purple tint */
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 15px;
            border: 2px solid rgba(79, 70, 229, 0.3);
            transition: all 0.4s ease-in-out;
            overflow: hidden;
            position: relative;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.1);
            padding: 2rem;
            text-align: center;
        }

        /* Hover Effect */
        .glass-card:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.3);
            border: 2px solid rgba(236, 72, 153, 0.4);
        }

        /* Profile Image Effects */
        .profile-img {
            width: 120px;
            height: 120px;
            border-radius: 10px;
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
            border: 2px solid transparent;
        }

        .glass-card:hover .profile-img {
            transform: scale(1.1);
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
            border: 2px solid rgba(236, 72, 153, 0.4);
        }

        /* Fade-in Animation */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fadeIn {
            animation: fadeIn 0.8s ease-in-out forwards;
        }

        /* Responsive Design */
        @media (max-width: 640px) {
            .glass-card {
                padding: 1.5rem;
            }
            .profile-img {
                width: 80px;
                height: 80px;
            }
        }

        
    </style>
</head>
<body>

