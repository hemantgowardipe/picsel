<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="This is the add event page of PICSEL">
    <title>PICSEL 2025</title>
    
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="errorbox flexbox flexbox-column" style="display:none;">
        <span class="flexbox">
            <button onclick="hideError()">X</button>
        </span>
        <div class="error-message">message</div>
    </div>

    <div class="addevent">
        <h1>Add Event</h1>
        <form onsubmit="handleSubmit(event)" enctype="multipart/form-data" class="flexbox-column">
            <input type="text" name="name" placeholder="Event Name" required>
            <input type="file" name="poster" required>
            <input type="datetime-local" name="date" required>
            <input type="text" name="venue" placeholder="Venue" required>
            <input type="text" name="link" placeholder="Registration Link (Optional)">

            <div class="rules-container">
                <label>Rules:</label>
                <div id="rulesContainer">
                    <input type="text" name="rules[]" placeholder="Add rule" required>
                </div>
                <button type="button" onclick="addRuleInput()">Add Another Rule</button>
            </div>

            <button type="submit">Add Event</button>
        </form>
    </div>

    <%- include('partials/footer') %>

    <script>
    function addRuleInput() {
        const container = document.getElementById("rulesContainer");
        const input = document.createElement("input");
        input.type = "text";
        input.name = "rules[]";
        input.placeholder = "Add rule";
        input.required = true;
        container.appendChild(input);
    }

    async function handleSubmit(event) {
        event.preventDefault(); // Prevent default form submission
        
        const form = event.target;
        const formData = new FormData(form);

        const response = await fetch("/api/addevent", {
            method: "POST",
            credentials: "include",
            body: formData // Automatically handles multipart/form-data
        });

        const result = await response.json();

        if (response.ok) {
            showError("Event added successfully!");
            form.reset(); // Clear form after success
        } else {
            showError("Failed to add event: " + result.message);
        }
    }

    function showError(message) {
        const errorBox = document.querySelector(".errorbox");
        errorBox.style.display = "flex";
        errorBox.querySelector(".error-message").innerText = message;
        document.body.style.overflow = "hidden";
    }

    function hideError() {
        const errorBox = document.querySelector(".errorbox");
        errorBox.style.display = "none";
        document.body.style.overflow = "auto";
    }
    </script>
</body>
</html>
