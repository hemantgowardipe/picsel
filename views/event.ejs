<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="This is the event page of PICSEL">
    <title>PICSEL 2025</title>
 <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <%-include('partials/navbar')%>

    <!-- Event Details -->
    <main class="flex-grow py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid md:grid-cols-2 gap-12 items-start">
                <!-- Event Image -->
                <div class="relative">
                    <img src="<%=event[0].poster%>" alt="<%=event[0].name%>" 
                        class="rounded-lg shadow-xl w-full h-full object-cover"/>
                </div>

                <!-- Event Information -->
                <div class="space-y-8">
                    <div class="flex justify-between items-start">
                        <h1 class="text-4xl font-bold text-gray-900"><%=event[0].name%></h1>
                        <button onclick="handleDelete(<%=event[0].id%>)" 
                            class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                            Delete Event
                        </button>
                    </div>

                    <!-- Event Details -->
                    <div class="bg-white rounded-lg shadow-md p-6 space-y-4">
                        <div class="flex items-center text-gray-600">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            <span>Date: <%=new Date(event[0].date).toLocaleDateString()%></span>
                        </div>
                        <div class="flex items-center text-gray-600">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span>Venue: <%=event[0].venue%></span>
                        </div>
                        <% if (event[0].link) { %>
                            <a href="<%=event[0].link%>" 
                                class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                Register Now
                            </a>
                        <% } %>
                    </div>

                    <!-- Rules Section -->
                    <div class="bg-white rounded-lg shadow-md p-6">
                        <h2 class="text-2xl font-bold text-gray-900 mb-4">Rules</h2>
                        <ol class="list-decimal list-inside space-y-2 text-gray-600">
                            <% event[0].rules.forEach(rule => { %>
                                <li><%=rule%></li>
                            <% }) %>
                        </ol>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%-include('partials/footer')%>

    <script>
        async function handleDelete(id){
            const result = await fetch(`/api/delevent/${id}`,{
                credentials:'include',
                method:'delete' 
            }).then(res=>res.json());
            alert(result.message);
        }
    </script>
</body>
</html>
