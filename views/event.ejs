<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="This is the add member page of PICSEL">
    <title>PICSEL 2025</title>
    
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <%-include('partials/navbar')%>
    <div class=" event-div flexbox-sa">
      <div class="flexbox-column flexbox-sa">
	<h1><%=event[0].name%></h1>
	<button onclick="handleDelete(<%=event[0].id%>)">Delete Event</button>
	<h2>Rules</h2>
	<ol>
<% event[0].rules.forEach(rule => { %>
                <li><%=rule%></li>
            <% }) %>
	</ol>
	
	<div class='flexbox-column'>
<span>Date: <%=new Date(event[0].date).toLocaleDateString()%></span>

	<span>Venue: <%=event[0].venue%></span>
            <a href="<%=event[0].link%>">Register</a>
	</div>

      </div>
      <img src="<%=event[0].poster%>" alt="<%=event[0].name%>"/>
    </div>

    <%-include('partials/footer')%>
    <script>
async function handleDelete(id){
    const result = await fetch(`/api/delevent/${id}`,{
credentials:'include',
     method:'delete' 
    }).then(res=>res.json());
    alert(result.message);
    
  }
    </script>
</body>
</html>
